package pages

import (
	"kazdel/pkg/ui/components"
	"kazdel/pkg/ui/icons"
)

templ ReportUrl(slug string) {
	@components.Base() {
		<div class="min-h-screen bg-base-100 text-base-content flex items-center justify-center p-6 font-sans">
			<div class="max-w-md w-full">
				<a
					href="/"
					class="cursor-pointer inline-flex items-center gap-2 text-base-content/50 hover:text-base-content transition-colors mb-8 font-bold tracking-widest text-xs uppercase"
				>
					@icons.ArrowLeft(24)
					Back to Home
				</a>
				<div
					id="report-url-form-div"
					class="bg-base-200 border border-base-content/10 p-10 shadow-[8px_8px_0px_0px_var(--color-base-content)]"
				>
					<h2 class="text-3xl font-bold tracking-tighter mb-4 uppercase text-error">
						Report Abuse
					</h2>
					<p class="text-sm text-base-content/70 mb-8">
						Found a malicious or abusive shortened link? Let us know so we can take it down.
					</p>
					@ReportUrlForm("", slug)
				</div>
			</div>
		</div>
	}
}

templ ReportUrlForm(errMessage string, slug string) {
	<form
		class="space-y-6"
		hx-post="/report"
		hx-swap="outerHTML"
	>
		if errMessage != "" {
			<div class="alert alert-error text-sm py-2 px-4 border border-error/20 bg-error/10 text-error rounded-none">
				{ errMessage }
			</div>
		}
		<div>
			<label class="block text-xs font-bold text-base-content/70 uppercase tracking-widest mb-2">
				Short URL / Slug
			</label>
			<input
				type="text"
				name="slug"
				value={ slug }
				placeholder="e.g. s1u2g3"
				class="peer w-full bg-base-100 border border-base-content/10 px-4 py-3 focus:outline-none focus:border-base-content transition-colors font-mono"
				required
			/>
		</div>
		<div>
			<label class="block text-xs font-bold text-base-content/70 uppercase tracking-widest mb-2">
				Reason
			</label>
			<select
				name="reason"
				class="peer w-full bg-base-100 border border-base-content/10 px-4 py-3 focus:outline-none focus:border-base-content transition-colors font-mono"
				required
			>
				<option value="" disabled selected>Select a reason...</option>
				<option value="spam">Spam or Unsolicited Promotions</option>
				<option value="phishing">Phishing or Malware</option>
				<option value="illegal">Illegal Content</option>
				<option value="harassment">Harassment or Hate Speech</option>
				<option value="other">Other</option>
			</select>
		</div>
		<div>
			<label class="block text-xs font-bold text-base-content/70 uppercase tracking-widest mb-2">
				Description / Additional Details
			</label>
			<textarea
				name="description"
				rows="3"
				placeholder="Please provide any additional details..."
				class="w-full bg-base-100 border border-base-content/10 px-4 py-3 focus:outline-none focus:border-base-content transition-colors font-mono"
			></textarea>
		</div>
		<div>
			<label class="block text-xs font-bold text-base-content/70 uppercase tracking-widest mb-2">
				Your Email (Optional)
			</label>
			<input
				type="email"
				name="email"
				placeholder="For follow-up questions"
				class="peer w-full bg-base-100 border border-base-content/10 px-4 py-3 focus:outline-none focus:border-base-content transition-colors font-mono"
			/>
		</div>
		<div class="relative group mt-4">
			<button
				type="submit"
				class="w-full relative z-10 btn-solid-3d bg-error! text-error-content! hover:bg-error/90!"
			>
				SUBMIT REPORT
			</button>
		</div>
	</form>
}

templ ReportUrlSuccess() {
	<div class="text-center">
		<div class="mb-6 flex justify-center text-success">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
		</div>
		<h3 class="text-2xl font-bold mb-2 uppercase tracking-tighter">Report Submitted</h3>
		<p class="text-base-content/70 mb-6">
			Thank you for helping keep our platform safe. We will review this link shortly.
		</p>
		<a href="/" class="btn-solid-3d inline-block w-full text-center">
			RETURN TO HOME
		</a>
	</div>
}
