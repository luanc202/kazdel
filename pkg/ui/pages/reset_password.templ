package pages

import (
	"kazdel/pkg/ui/components"
)

templ ResetPassword(token string) {
	@components.Base() {
		<div class="min-h-screen bg-base-100 text-base-content flex items-center justify-center p-6 font-sans">
			<div class="max-w-md w-full">
				<div
					id="reset-password-form-div"
					class="bg-base-200 border border-base-content/10 p-10 shadow-[8px_8px_0px_0px_var(--color-base-content)]"
				>
					<h2 class="text-3xl font-bold tracking-tighter mb-4 uppercase">
						New Password
					</h2>
					<p class="text-sm text-base-content/70 mb-8">
						Please enter your new password below.
					</p>
					@ResetPasswordForm(token, "")
				</div>
			</div>
		</div>
	}
}

templ ResetPasswordForm(token string, errMessage string) {
	<form
		class="space-y-6"
		hx-post="/api/v1/auth/reset-password"
		hx-swap="outerHTML"
	>
		if errMessage != "" {
			<div class="alert alert-error text-sm py-2 px-4 border border-error/20 bg-error/10 text-error rounded-none">
				{ errMessage }
			</div>
		}
		<input type="hidden" name="token" value={ token } />
		<div>
			<label class="block text-xs font-bold text-base-content/70 uppercase tracking-widest mb-2">
				New Password
			</label>
			<input
				id="password"
				name="password"
				type="password"
				placeholder="••••••••"
				minlength="8"
				pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[!@#$%^&*]).{8,}"
				title="Must contain at least 8 characters, including uppercase, lowercase, numbers and special characters"
				class="peer w-full bg-base-100 border border-base-content/10 px-4 py-3 focus:outline-none focus:border-base-content transition-colors font-mono [&:not(:placeholder-shown):invalid]:border-error [&:not(:placeholder-shown):valid]:border-success"
				required
			/>
			<p class="mt-2 text-sm text-error hidden peer-[:not(:placeholder-shown):invalid]:block">
				Must contain at least 8 characters, including uppercase, lowercase, number, and special character.
			</p>
		</div>
		<div>
			<label class="block text-xs font-bold text-base-content/70 uppercase tracking-widest mb-2">
				Confirm Password
			</label>
			<input
				id="confirm_password"
				name="confirm_password"
				type="password"
				placeholder="••••••••"
				minlength="8"
				class="peer w-full bg-base-100 border border-base-content/10 px-4 py-3 focus:outline-none focus:border-base-content transition-colors font-mono [&:not(:placeholder-shown):invalid]:border-error [&:not(:placeholder-shown):valid]:border-success"
				required
			/>
		</div>
		<div class="relative group mt-4">
			<button
				type="submit"
				class="w-full relative z-10 btn-solid-3d"
			>
				SAVE NEW PASSWORD
			</button>
		</div>
	</form>
}
