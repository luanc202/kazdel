package pages

import (
	"kazdel/pkg/ui/components"
	"kazdel/pkg/ui/icons"
)

templ ForgotPassword() {
	@components.Base() {
		<div class="min-h-screen bg-base-100 text-base-content flex items-center justify-center p-6 font-sans">
			<div class="max-w-md w-full">
				<a
					href="/login"
					class="cursor-pointer inline-flex items-center gap-2 text-base-content/50 hover:text-base-content transition-colors mb-8 font-bold tracking-widest text-xs uppercase"
				>
					@icons.ArrowLeft(24)
					Back to Login
				</a>
				<div
					id="forgot-password-form-div"
					class="bg-base-200 border border-base-content/10 p-10 shadow-[8px_8px_0px_0px_var(--color-base-content)]"
				>
					<h2 class="text-3xl font-bold tracking-tighter mb-4 uppercase">
						Reset Password
					</h2>
					<p class="text-sm text-base-content/70 mb-8">
						Enter your email address and we will send you a link to reset your password.
					</p>
					@ForgotPasswordForm("")
				</div>
			</div>
		</div>
	}
}

templ ForgotPasswordForm(errMessage string) {
	<form
		class="space-y-6"
		hx-post="/api/v1/auth/forgot-password"
		hx-swap="outerHTML"
	>
		if errMessage != "" {
			<div class="alert alert-error text-sm py-2 px-4 border border-error/20 bg-error/10 text-error rounded-none">
				{ errMessage }
			</div>
		}
		<div>
			<label class="block text-xs font-bold text-base-content/70 uppercase tracking-widest mb-2">
				Email
			</label>
			<input
				type="email"
				name="email"
				placeholder="[EMAIL ADDRESS]"
				class="peer w-full bg-base-100 border border-base-content/10 px-4 py-3 focus:outline-none focus:border-base-content transition-colors font-mono [&:not(:placeholder-shown):invalid]:border-error [&:not(:placeholder-shown):valid]:border-success"
				required
			/>
			<p class="mt-2 text-sm text-error hidden peer-[:not(:placeholder-shown):invalid]:block">
				Please enter a valid email address.
			</p>
		</div>
		<div class="relative group mt-4">
			<button
				type="submit"
				class="w-full relative z-10 btn-solid-3d"
			>
				SEND RESET LINK
			</button>
		</div>
	</form>
}

templ ForgotPasswordSuccess() {
	<div class="text-center">
		<div class="mb-6 flex justify-center text-success">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
			</svg>
		</div>
		<h3 class="text-2xl font-bold mb-2 uppercase tracking-tighter">Check Your Inbox</h3>
		<p class="text-base-content/70 mb-6">
			If an account exists for that email, we have sent password reset instructions.
		</p>
		<a href="/login" class="btn-solid-3d inline-block w-full text-center">
			RETURN TO LOGIN
		</a>
	</div>
}
