					@icons.Pencil("18")
				</button>
				<a
					href={ templ.SafeURL(url.OriginalUrl) }
					target="_blank"
					rel="noopener noreferrer"
					class="p-2 btn-action-3d"
					title="Open Link"
				>
					@icons.ExternalLink("18")
				</a>
				<button
					@click="confirmingDelete = true"
					type="button"
					class="p-2 btn-action-3d"
					title="Delete"
				>
					@icons.Trash("18")
				</button>
			</div>
			<div
				x-cloak
