		<div class="col-span-3 truncate font-mono text-sm text-base-content/70" title={ url.OriginalUrl }>
			{ url.OriginalUrl }
		</div>
		<div class="col-span-2 font-bold text-sm tracking-tight flex items-center gap-2">
			<button
				data-slug={ url.ShortSlug }
				onclick="
					navigator.clipboard.writeText(window.location.origin + '/' + this.getAttribute('data-slug'));
