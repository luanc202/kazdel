package pages

import (
	"kazdel/pkg/entity/dto"
	"kazdel/pkg/ui/components"
	"kazdel/pkg/ui/icons"
	"time"
)

templ CreateUrlForm(errMessage string, originalUrl string, defaultExpiresAt string, customSlug string, description string) {
	<form id="shorten-form" x-data="{ showOptional: false }" hx-post="/dashboard/urls/shorten" hx-swap="outerHTML" class="flex flex-col gap-4 mb-12">
		if errMessage != "" {
			<div class="alert alert-error text-sm py-2 px-4 border border-error/20 bg-error/10 text-error rounded-none">
				{ errMessage }
			</div>
		}
		<div class="flex flex-col md:flex-row gap-4 items-stretch">
			<input
				type="url"
				name="originalUrl"
				placeholder="PASTE_LONG_URL_HERE"
				value={ originalUrl }
				class="flex-1 bg-base-200 border-2 border-base-content/10 px-6 py-4 text-xl font-bold focus:outline-none focus:border-base-content transition-colors placeholder:text-base-content/20"
				required
			/>
			<button
				type="button"
				@click="showOptional = !showOptional"
				class="bg-base-200 border-2 border-base-content/10 px-4 py-4 flex items-center justify-center hover:bg-base-content/10 text-base-content"
				title="Toggle Optional Fields"
			>
				<svg x-bind:class="showOptional ? 'rotate-180' : ''" class="w-6 h-6 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="6 9 12 15 18 9"></polyline>
				</svg>
			</button>
			<div class="relative group">
				<button
					type="submit"
					class="w-full h-full flex flex-row items-center justify-center gap-2 relative z-10 btn-solid-3d"
				>
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
					SHORTEN
				</button>
			</div>
		</div>
		<div
			x-cloak
			x-show="showOptional"
			x-transition:enter="glitch-enter"
			x-transition:leave="glitch-leave"
			class="relative grid grid-cols-1 gap-4 md:grid-cols-2 items-stretch"
		>
			<input
				type="datetime-local"
				name="expiresAt"
				title="Expiration Date"
				value={ defaultExpiresAt }
				class="flex-1 bg-base-200 border-2 border-base-content/10 px-6 py-4 text-xl font-bold focus:outline-none focus:border-base-content transition-colors text-base-content/70"
				required
			/>
			<input
				type="text"
				name="customSlug"
				placeholder="CUSTOM_SLUG"
				value={ customSlug }
				class="flex-1 bg-base-200 border-2 border-base-content/10 px-6 py-4 text-xl font-bold focus:outline-none focus:border-base-content transition-colors placeholder:text-base-content/20"
			/>
			<input
				type="text"
				name="description"
				placeholder="DESCRIPTION"
				value={ description }
				class="flex-1 bg-base-200 border-2 border-base-content/10 px-6 py-4 text-xl font-bold focus:outline-none focus:border-base-content transition-colors placeholder:text-base-content/20"
			/>
			<input
				type="password"
				name="password"
				placeholder="PASSWORD"
				class="flex-1 bg-base-200 border-2 border-base-content/10 px-6 py-4 text-xl font-bold focus:outline-none focus:border-base-content transition-colors placeholder:text-base-content/20"
			/>
		</div>
	</form>
}

templ UrlRow(url dto.ShortenedUrlView) {
	<div class="grid grid-cols-12 gap-4 bg-base-200 border border-base-content/10 p-6 items-center hover:border-base-content/30 transition-all duration-500 group [&.htmx-swapping]:opacity-0 [&.htmx-swapping]:scale-95 [&.htmx-swapping]:-translate-x-4">
		<div class="col-span-5 truncate font-mono text-sm text-base-content/70" title={ url.OriginalUrl }>
			{ url.OriginalUrl }
		</div>
		<div class="col-span-3 font-bold text-lg tracking-tight">
			{ url.ShortSlug }
		</div>
		<div class="col-span-2 font-mono text-base-content/50">
			{ url.ExpiresAt }
		</div>
		<div class="col-span-2 flex justify-end items-center relative min-h-[40px] w-full" x-data="{ confirmingDelete: false }">
			<div
				x-show="!confirmingDelete"
				x-transition:enter="transition ease-out duration-300 delay-100"
				x-transition:enter-start="opacity-0 -translate-x-8"
				x-transition:enter-end="opacity-100 translate-x-0"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-x-0"
				x-transition:leave-end="opacity-0 -translate-x-8"
				class="absolute right-0 flex justify-end gap-3"
			>
				<button
					hx-get={ "/dashboard/urls/" + url.ShortSlug + "/edit" }
					hx-target="closest .grid"
					hx-swap="outerHTML swap:150ms settle:200ms"
					class="p-2 btn-action-3d"
					title="Edit Link"
				>
					@icons.PencilIcon("18")
				</button>
				<button
					data-slug={ url.ShortSlug }
					onclick="navigator.clipboard.writeText(window.location.origin + '/' + this.getAttribute('data-slug'))"
					class="p-2 btn-action-3d"
					title="Copy Link"
				>
					@icons.CopyIcon("18")
				</button>
				<a
					href={ templ.SafeURL(url.OriginalUrl) }
					target="_blank"
					rel="noopener noreferrer"
					class="p-2 btn-action-3d"
					title="Open Link"
				>
					@icons.ExternalLinkIcon("18")
				</a>
				<button
					@click="confirmingDelete = true"
					type="button"
					class="p-2 btn-action-3d"
					title="Delete"
				>
					@icons.TrashIcon("18")
				</button>
			</div>
			<div
				x-cloak
				x-show="confirmingDelete"
				x-transition:enter="transition ease-out duration-300 delay-100"
				x-transition:enter-start="opacity-0 translate-x-8"
				x-transition:enter-end="opacity-100 translate-x-0"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-x-0"
				x-transition:leave-end="opacity-0 translate-x-8"
				style="display: none;"
				class="absolute right-0 grid grid-cols-2 items-center justify-end gap-2 text-[0.5rem] font-bold whitespace-nowrap"
			>
				<span class="text-content text-center text-shadow-lg col-span-2 text-sm mr-1">ARE YOU <span class="text-error underline decoration-error decoration-2">SURE?</span></span>
				<button
					hx-delete={ "/dashboard/urls/" + url.ShortSlug }
					hx-target="closest .group"
					hx-swap="outerHTML swap:500ms"
					class="px-2 py-1 btn-danger-3d text-base"
				>
					YES
				</button>
				<button
					@click="confirmingDelete = false"
					type="button"
					class="px-2 py-1 btn-action-3d text-base"
				>
					NO
				</button>
			</div>
		</div>
	</div>
}

templ EditUrlRow(url dto.ShortenedUrlView, errMessage string) {
	<form hx-post={ "/dashboard/urls/" + url.ShortSlug + "/edit" } hx-target="this" hx-swap="outerHTML swap:150ms settle:200ms" class="grid grid-cols-12 gap-4 bg-base-200 border-2 border-base-content/30 p-6 items-center">
		if errMessage != "" {
			<div class="col-span-12 alert alert-error text-sm py-2 px-4 border border-error/20 bg-error/10 text-error rounded-none">
				{ errMessage }
			</div>
		}
		<div class="col-span-12 flex flex-col gap-4">
			<input
				type="url"
				name="originalUrl"
				placeholder="LONG_URL"
				value={ url.OriginalUrl }
				class="w-full bg-base-100 border-2 border-base-content/10 px-4 py-2 text-sm font-bold focus:outline-none focus:border-base-content transition-colors"
				required
			/>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				<input
					type="datetime-local"
					name="expiresAt"
					value={ url.RawExpiresAt }
					class="w-full bg-base-100 border-2 border-base-content/10 px-4 py-2 text-sm font-bold focus:outline-none focus:border-base-content transition-colors"
					required
				/>
				<input
					type="text"
					name="description"
					placeholder="DESCRIPTION"
					value={ url.Description }
					class="w-full bg-base-100 border-2 border-base-content/10 px-4 py-2 text-sm font-bold focus:outline-none focus:border-base-content transition-colors"
				/>
				<input
					type="password"
					name="password"
					placeholder={ func() string { if url.HasPassword { return "NEW_PASSWORD" }; return "PASSWORD" }() }
					class="w-full bg-base-100 border-2 border-base-content/10 px-4 py-2 text-sm font-bold focus:outline-none focus:border-base-content transition-colors"
				/>
			</div>
			<div class="flex justify-end gap-2 mt-2">
				<button
					type="submit"
					class="px-4 py-2 btn-solid-3d text-sm"
				>
					SAVE
				</button>
				<button
					type="button"
					hx-get={ "/dashboard/urls/" + url.ShortSlug }
					hx-target="closest .grid"
					hx-swap="outerHTML swap:150ms settle:200ms"
					class="px-4 py-2 btn-action-3d text-sm"
				>
					CANCEL
				</button>
			</div>
		</div>
	</form>
}

templ Dashboard(urls []dto.ShortenedUrlView) {
	@components.Base() {
		<div class="min-h-screen bg-base-100 text-base-content p-6 md:p-12 font-sans">
			<div class="max-w-5xl mx-auto">
				<header class="flex justify-between items-center mb-12 border-b border-base-content/10 pb-8">
					<div>
						<h1 class="text-4xl font-bold tracking-tighter">DASHBOARD</h1>
						<p class="text-base-content/50 text-sm font-mono mt-1">USER_SESSION: ACTIVE</p>
					</div>
					<a
						hx-post="/api/v1/auth/logout"
						hx-target="body"
						hx-swap="innerHTML"
						class="text-base-content/50 hover:text-base-content transition-colors uppercase text-xs font-bold tracking-widest"
					>
						Logout
					</a>
				</header>
				@CreateUrlForm("", "", time.Now().AddDate(0, 0, 7).Format("2006-01-02T15:04"), "", "")
				<section class="space-y-4">
					<div class="grid grid-cols-12 gap-4 px-6 py-2 text-xs font-bold text-base-content/30 uppercase tracking-widest">
						<div class="col-span-5">Original URL</div>
						<div class="col-span-3">Short Code</div>
						<div class="col-span-2">Expires</div>
						<div class="col-span-2 text-right">Actions</div>
					</div>
					<div id="url-list" class="space-y-4">
						if len(urls) == 0 {
							<div id="empty-state" class="border border-dashed border-base-content/10 p-12 text-center text-base-content/20 font-bold text-xl uppercase tracking-widest">
								No URLs found in protocol
							</div>
						} else {
							for _, url := range urls {
								@UrlRow(url)
							}
						}
					</div>
				</section>
			</div>
		</div>
	}
}
