package pages

import (
	"kazdel/pkg/entity/dto"
	"kazdel/pkg/ui/components"
	"time"
)

templ CreateUrlForm(errMessage string, originalUrl string, defaultExpiresAt string) {
	<form id="shorten-form" hx-post="/dashboard/urls/shorten" hx-swap="outerHTML" class="flex flex-col gap-4 mb-12">
		if errMessage != "" {
			<div class="alert alert-error text-sm py-2 px-4 border border-error/20 bg-error/10 text-error rounded-none">
				{ errMessage }
			</div>
		}
		<div class="flex flex-col md:flex-row gap-4 items-stretch">
			<input
				type="url"
				name="originalUrl"
				placeholder="PASTE_LONG_URL_HERE"
				value={ originalUrl }
				class="flex-1 bg-base-200 border-2 border-base-content/10 px-6 py-4 text-xl font-bold focus:outline-none focus:border-base-content transition-colors placeholder:text-base-content/20"
				required
			/>
			<input
				type="datetime-local"
				name="expiresAt"
				title="Expiration Date"
				value={ defaultExpiresAt }
				class="w-full md:w-auto bg-base-200 border-2 border-base-content/10 px-6 py-4 text-xl font-bold focus:outline-none focus:border-base-content transition-colors text-base-content/70"
				required
			/>
			<div class="relative group">
				<button
					type="submit"
					class="w-full flex flex-row items-center gap-2 relative z-10 btn-solid-3d"
				>
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
					SHORTEN
				</button>
			</div>
		</div>
	</form>
}

templ UrlRow(url dto.ShortenedUrlView) {
	<div class="grid grid-cols-12 gap-4 bg-base-200 border border-base-content/10 p-6 items-center hover:border-base-content/30 transition-colors group">
		<div class="col-span-5 truncate font-mono text-sm text-base-content/70" title={ url.OriginalUrl }>
			{ url.OriginalUrl }
		</div>
		<div class="col-span-3 font-bold text-lg tracking-tight">
			{ url.ShortSlug }
		</div>
		<div class="col-span-2 font-mono text-base-content/50">
			{ url.ExpiresAt }
		</div>
		<div class="col-span-2 flex justify-end items-center" x-data="{ confirmingDelete: false }">
			<div x-show="!confirmingDelete" class="flex justify-end gap-3">
				<button
					data-slug={ url.ShortSlug }
					onclick="navigator.clipboard.writeText(window.location.origin + '/' + this.getAttribute('data-slug'))"
					class="p-2 btn-action-3d"
					title="Copy Link"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
				</button>
				<a
					href={ templ.SafeURL(url.OriginalUrl) }
					target="_blank"
					rel="noopener noreferrer"
					class="p-2 btn-action-3d"
					title="Open Link"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
				</a>
				<button
					@click="confirmingDelete = true"
					type="button"
					class="p-2 btn-action-3d"
					title="Delete"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
				</button>
			</div>
			<div x-cloak x-show="confirmingDelete" style="display: none;" class="flex items-center justify-end gap-2 text-xs font-bold w-full">
				<span class="text-error text-shadow-lg text-sm mr-1">ARE YOU <span class="underline decoration-error decoration-2">SURE?</span></span>
				<button
					hx-delete={ "/dashboard/urls/" + url.ShortSlug }
					hx-target="closest .group"
					hx-swap="outerHTML"
					class="px-2 py-1 btn-danger-3d"
				>
					YES
				</button>
				<button
					@click="confirmingDelete = false"
					type="button"
					class="px-2 py-1 btn-action-3d"
				>
					NO
				</button>
			</div>
		</div>
	</div>
}

templ Dashboard(urls []dto.ShortenedUrlView) {
	@components.Base() {
		<div class="min-h-screen bg-base-100 text-base-content p-6 md:p-12 font-sans">
			<div class="max-w-5xl mx-auto">
				<header class="flex justify-between items-center mb-12 border-b border-base-content/10 pb-8">
					<div>
						<h1 class="text-4xl font-bold tracking-tighter">DASHBOARD</h1>
						<p class="text-base-content/50 text-sm font-mono mt-1">USER_SESSION: ACTIVE</p>
					</div>
					<a
						href="/api/v1/auth/logout"
						class="text-base-content/50 hover:text-base-content transition-colors uppercase text-xs font-bold tracking-widest"
					>
						Logout
					</a>
				</header>
				@CreateUrlForm("", "", time.Now().AddDate(0, 0, 7).Format("2006-01-02T15:04"))
				<section class="space-y-4">
					<div class="grid grid-cols-12 gap-4 px-6 py-2 text-xs font-bold text-base-content/30 uppercase tracking-widest">
						<div class="col-span-5">Original URL</div>
						<div class="col-span-3">Short Code</div>
						<div class="col-span-2">Expires</div>
						<div class="col-span-2 text-right">Actions</div>
					</div>
					<div id="url-list" class="space-y-4">
						if len(urls) == 0 {
							<div id="empty-state" class="border border-dashed border-base-content/10 p-12 text-center text-base-content/20 font-bold text-xl uppercase tracking-widest">
								No URLs found in protocol
							</div>
						} else {
							for _, url := range urls {
								@UrlRow(url)
							}
						}
					</div>
				</section>
			</div>
		</div>
	}
}
