package components

templ PasswordPrompt(slug string, errMessage string) {
	@Base() {
		<div class="min-h-screen bg-base-100 text-base-content flex items-center justify-center p-6">
			<div class="max-w-md w-full">
				<h1 class="text-3xl font-bold tracking-tighter mb-6 text-center">LINK PROTECTED</h1>
				<form action={ templ.SafeURL("/" + slug + "/password") } method="POST" class="flex flex-col gap-4">
					if errMessage != "" {
						<div class="alert alert-error text-sm py-2 px-4 border border-error/20 bg-error/10 text-error rounded-none text-center">
							{ errMessage }
						</div>
					}
					<input
						type="password"
						name="password"
						placeholder="ENTER PASSWORD"
						class="w-full bg-base-200 border-2 border-base-content/10 px-6 py-4 text-xl font-bold focus:outline-none focus:border-base-content transition-colors placeholder:text-base-content/20 text-center"
						required
						autofocus
					/>
					<button
						type="submit"
						class="w-full btn-solid-3d py-4 text-xl tracking-widest uppercase font-bold"
					>
						Unlock Link
					</button>
				</form>
			</div>
		</div>
	}
}
